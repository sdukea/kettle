# Copy to .env and fill in. Never commit .env.
# Server reads these through apps/server/src/env.ts (zod-validated, fails fast).

# ── Database (V1+) ─────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/nue_dev
TEST_DATABASE_URL=postgres://localhost:5432/nue_test

# ── AI (V0+) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NUE_MODEL_REASONING=claude-sonnet-5
NUE_MODEL_CLASSIFY=claude-haiku-4-5

# ── Auth (V1+) ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=                 # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional ───────────────────────────────────────────────────
RESEND_API_KEY=                     # unset locally: magic links print to the console
SENTRY_DSN=
POSTHOG_KEY=
